{
  "chapters": [
    {
      "chapterId": "chapter-1",
      "title": "暖灯与失语之森",
      "nodes": [
        {
          "nodeId": "inn.arrival",
          "type": "choice",
          "title": "暖灯旅店",
          "text": "信纸边缘又淡了一角。旅伴把暖灯放在桌沿，替你留出靠近炉火的位置。",
          "choices": [
            {
              "choiceId": "prepare",
              "label": "拿起暖灯，准备出发",
              "targetNodeId": "inn.preparation"
            }
          ]
        },
        {
          "nodeId": "inn.preparation",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "临行前的笔记",
          "text": "旅伴在便笺上写下 lantern，又把纸角折进你的地图。今晚先记住它，再让灯光替你引路。",
          "nextNodeId": "forest.signpost"
        },
        {
          "nodeId": "forest.signpost",
          "type": "choice",
          "title": "失语之森",
          "text": "两道路痕都通向溪桥。雾里有木头受压的轻响，也有守卫缓慢的呼吸声。",
          "choices": [
            {
              "choiceId": "cross",
              "label": "沿提灯照亮的旧路前进",
              "targetNodeId": "bridge.guardian"
            }
          ]
        },
        {
          "nodeId": "bridge.guardian",
          "type": "encounter",
          "title": "雾中溪桥",
          "text": "桥雾聚成守卫。它没有夺走道路，只要求你们用真实的回忆换取每一次行动。",
          "encounterId": "bridge-guardian",
          "victoryNodeId": "bridge.crossed",
          "rescueNodeId": "bridge.assisted"
        },
        {
          "nodeId": "bridge.crossed",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "桥后的灯影",
          "text": "迷雾散开时，旅伴替你把暖灯重新举高。你们没有猜中答案，而是真的把词从记忆里找了回来。",
          "nextNodeId": "camp.letter"
        },
        {
          "nodeId": "bridge.assisted",
          "type": "camp",
          "speaker": "旅伴",
          "title": "溪桥救援",
          "text": "你被带回安全的路边。旅伴没有责怪，只把水袋递给你，又把这次没想起来的词认真地圈了一遍。",
          "nextNodeId": "camp.fire"
        },
        {
          "nodeId": "camp.letter",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "伙伴的对话",
          "text": "“你把 promise 和 guardian 都写对了。”旅伴靠在你身边，“明天再看见这座桥时，我们会记得今晚的火光。”",
          "nextNodeId": "camp.fire"
        },
        {
          "nodeId": "camp.fire",
          "type": "camp",
          "speaker": "旅伴",
          "title": "营火",
          "text": "暖灯挂在树梢，营火把第一章的路标照得清清楚楚。你们把今天的词一条条收进旅途笔记。",
          "recollectionId": "first-camp",
          "recollectionTitle": "第一章的营火",
          "recollectionText": "暖灯与营火一起照亮第一章的路标。",
          "nextNodeId": "chapter1.end"
        },
        {
          "nodeId": "chapter1.end",
          "type": "chapter-end",
          "title": "第一章完成",
          "text": "旅伴在营火旁合上笔记。钟楼的方向传来很轻的回声，下一段路已经在地图上显出来。",
          "nextNodeId": "chapter2.arrival"
        }
      ]
    },
    {
      "chapterId": "chapter-2",
      "title": "古钟塔与绘图师",
      "nodes": [
        {
          "nodeId": "chapter2.arrival",
          "type": "dialogue",
          "speaker": "菲妮",
          "portraitCharacterId": "fina",
          "unlockCharacterId": "fina",
          "recollectionId": "fina-meets",
          "recollectionTitle": "罗盘与远路的绘图师",
          "recollectionText": "菲妮在古钟塔外摊开地图，罗盘指向一条被苔藓遮住的旧路。",
          "title": "塔下的新同伴",
          "text": "一个抱着地图筒的女孩从塔影里探出头。她看了看罗盘，又看了看你们：“这条路我画过三次，只有这次看见灯。叫我菲妮吧。”",
          "nextNodeId": "chapter2.camp"
        },
        {
          "nodeId": "chapter2.camp",
          "type": "camp",
          "speaker": "旅伴",
          "title": "塔外营地",
          "text": "菲妮把地图铺在石阶上，标出钟塔、旧井和一条穿过墙根的路。你们可以在这里决定带谁继续前进。",
          "nextNodeId": "chapter2.choice"
        },
        {
          "nodeId": "chapter2.choice",
          "type": "choice",
          "title": "古钟塔",
          "text": "钟声每隔一会儿就响一次，却没有钟摆的声音。塔门旁留着两条不同的足迹。",
          "choices": [
            {
              "choiceId": "climb",
              "label": "沿石阶登上钟塔",
              "targetNodeId": "chapter2.tower"
            },
            {
              "choiceId": "listen",
              "label": "先听墙内的回声",
              "targetNodeId": "chapter2.tower"
            }
          ]
        },
        {
          "nodeId": "chapter2.tower",
          "type": "dialogue",
          "speaker": "菲妮",
          "portraitCharacterId": "fina",
          "title": "停住的钟",
          "text": "菲妮把 compass 放在钟盘下方，指针没有朝北，而是慢慢转向钟塔内部。“不是钟停了。是它一直在等我们回答。”",
          "nextNodeId": "chapter2.sentinel"
        },
        {
          "nodeId": "chapter2.sentinel",
          "type": "encounter",
          "title": "钟摆守卫",
          "encounterId": "clockwork-sentinel",
          "victoryNodeId": "chapter2.victory",
          "rescueNodeId": "chapter2.rescue",
          "text": "齿轮从墙内转起来，钟摆聚成一名守卫。每一次回答都会让停住的钟向前走一格。"
        },
        {
          "nodeId": "chapter2.victory",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "重新走动的钟",
          "text": "钟摆终于落下。菲妮在塔壁里找到一张旧地图，上面的塔画得比现在更高，还多了一条通往树心的线。",
          "nextNodeId": "chapter2.campfire"
        },
        {
          "nodeId": "chapter2.rescue",
          "type": "camp",
          "speaker": "旅伴",
          "title": "钟塔救援",
          "text": "菲妮把你拉出齿轮的阴影，又把没回答好的词圈在地图边角：“路会记得我们走过，别急着重来。”",
          "nextNodeId": "chapter2.campfire"
        },
        {
          "nodeId": "chapter2.campfire",
          "type": "camp",
          "speaker": "菲妮",
          "portraitCharacterId": "fina",
          "title": "第二章营火",
          "recollectionId": "clock-tower",
          "recollectionTitle": "钟塔重新走动",
          "recollectionText": "菲妮在营火边补完地图，把古钟塔和树心之路画在一起。",
          "text": "菲妮把 tower 和 clock 写在地图两侧，又在中间添了一盏很小的灯。下一站是古树之心，那里也许藏着最后一封回信。",
          "nextNodeId": "chapter2.end"
        },
        {
          "nodeId": "chapter2.end",
          "type": "chapter-end",
          "title": "第二章完成",
          "text": "钟塔重新走动。菲妮收起地图筒，已经站在旅团身边准备出发。",
          "nextNodeId": "coast.invitation"
        }
      ]
    },
    {
      "chapterId": "coast-1",
      "title": "潮声海湾",
      "nodes": [
        {
          "nodeId": "coast.invitation",
          "type": "choice",
          "title": "潮声海湾",
          "sceneId": "coast-beach",
          "costumeId": "beach-swimwear",
          "text": "第二章的钟声落下后，海风把一张潮湿的漂流信吹到脚边。莉娅把外衣收进布包，瑟琳把记事册塞进草袋，海湾的支路在午后的阳光里展开。",
          "choices": [
            {
              "choiceId": "tidepools",
              "label": "先去潮汐浅滩查看路标",
              "targetNodeId": "coast.tidepools"
            },
            {
              "choiceId": "letter",
              "label": "先把漂流信整理好",
              "targetNodeId": "coast.letter"
            },
            {
              "choiceId": "continue-main",
              "label": "不绕路，继续去古树之心",
              "targetNodeId": "chapter3.arrival"
            }
          ]
        },
        {
          "nodeId": "coast.tidepools",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "潮汐浅滩",
          "sceneId": "coast-tidepools",
          "costumeId": "beach-swimwear",
          "text": "潮水退到礁石外，浅滩里留下贝壳、发亮的海藻和一条被冲刷得发白的旧路标。旅伴蹲下来，把 tide 和 shell 写在水边的沙上。",
          "nextNodeId": "coast.guardian"
        },
        {
          "nodeId": "coast.letter",
          "type": "dialogue",
          "speaker": "瑟琳",
          "portraitCharacterId": "serin",
          "title": "漂流信",
          "sceneId": "coast-tidepools",
          "costumeId": "beach-swimwear",
          "text": "瑟琳把信纸压在干燥的礁石上，读出被盐渍咬过的字：“请把 light 带给还在海上的人。”她把 shore 和 drift 圈在页角，抬头看见潮水正在退去。",
          "nextNodeId": "coast.guardian"
        },
        {
          "nodeId": "coast.guardian",
          "type": "encounter",
          "title": "潮汐守卫",
          "sceneId": "coast-tidepools",
          "costumeId": "beach-swimwear",
          "encounterId": "tide-guardian",
          "victoryNodeId": "coast.victory",
          "rescueNodeId": "coast.rescue",
          "text": "一只由海水和碎光组成的潮汐守卫从浅滩里站起。它没有夺走路标，只要求你们把刚才看见的词真正想起来。"
        },
        {
          "nodeId": "coast.victory",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "潮水让路",
          "sceneId": "coast-lighthouse",
          "costumeId": "beach-swimwear",
          "text": "潮汐守卫散成一片细小的浪花。灯塔的方向亮起一点暖光，旅伴把灯塔的方位记在漂流信背面，准备沿着海崖去点亮它。",
          "nextNodeId": "coast.camp"
        },
        {
          "nodeId": "coast.rescue",
          "type": "camp",
          "speaker": "旅伴",
          "title": "海边休息点",
          "sceneId": "coast-lighthouse",
          "costumeId": "beach-swimwear",
          "text": "你被带回海崖下的浅滩。旅伴把水壶和毛巾递过来，没有责怪你；漂流信还压在石头下，潮声也还在继续。",
          "nextNodeId": "coast.camp"
        },
        {
          "nodeId": "coast.camp",
          "type": "camp",
          "speaker": "旅伴",
          "title": "潮声营地",
          "sceneId": "coast-beach",
          "costumeId": "beach-swimwear",
          "recollectionId": "tide-song",
          "recollectionTitle": "潮声与漂流信",
          "recollectionText": "莉娅和瑟琳在潮声里把漂流信收进旅记，灯塔的暖光第一次照到海岸。",
          "text": "你们在背风的礁石后生起一小堆火。莉娅晾好毛巾，瑟琳把信纸夹进记事册；可以在这里切换带队伙伴，也可以让潮声陪你们多坐一会儿。",
          "nextNodeId": "coast.lighthouse"
        },
        {
          "nodeId": "coast.lighthouse",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "潮声灯塔",
          "sceneId": "coast-lighthouse",
          "costumeId": "summer-travel",
          "text": "离开浅滩前，大家换回轻便的旅行装。灯塔重新亮起，beacon 和 lighthouse 也留在旅记里；回程的路标不再被潮水遮住。",
          "nextNodeId": "coast.end"
        },
        {
          "nodeId": "coast.end",
          "type": "chapter-end",
          "title": "潮声海湾完成",
          "text": "海风把回信送回旅团手中。你们没有催自己记住所有词，只把这一段潮声和亮起的灯一起收好。",
          "nextNodeId": "chapter3.arrival"
        }
      ]
    },
    {
      "chapterId": "chapter-3",
      "title": "古树之心与回信",
      "nodes": [
        {
          "nodeId": "chapter3.arrival",
          "type": "choice",
          "title": "古树之心",
          "text": "树根像道路一样铺开，树心里传来翻动信纸的声音。菲妮的罗盘第一次同时指向两个方向。",
          "choices": [
            {
              "choiceId": "follow-compass",
              "label": "跟随罗盘的指针",
              "targetNodeId": "chapter3.grove"
            },
            {
              "choiceId": "follow-roots",
              "label": "沿树根间的微光前进",
              "targetNodeId": "chapter3.grove"
            }
          ]
        },
        {
          "nodeId": "chapter3.grove",
          "type": "dialogue",
          "speaker": "菲妮",
          "portraitCharacterId": "fina",
          "title": "树心的路",
          "text": "“root 不只是树扎进土里的部分。”菲妮指了指地图上的家，“它也可以是一个人愿意回去的地方。”",
          "nextNodeId": "chapter3.guardian"
        },
        {
          "nodeId": "chapter3.guardian",
          "type": "encounter",
          "title": "古树守卫",
          "encounterId": "heartwood-guardian",
          "victoryNodeId": "chapter3.victory",
          "rescueNodeId": "chapter3.rescue",
          "text": "树心守卫从年轮中醒来。它守着最后一封信，也守着每一个想回家的人必须自己走完的路。"
        },
        {
          "nodeId": "chapter3.victory",
          "type": "dialogue",
          "speaker": "旅伴",
          "title": "树心的回信",
          "text": "年轮缓缓打开，最后一封信落在你们手中。菲妮在地图背面写下 home 这个词，又把笔递给你。",
          "nextNodeId": "chapter3.campfire"
        },
        {
          "nodeId": "chapter3.rescue",
          "type": "camp",
          "speaker": "旅伴",
          "title": "树心救援",
          "text": "你们退回树根围成的安全空地。菲妮把水壶递过来：“救援不是失败。地图上也会标出不能硬闯的路。”",
          "nextNodeId": "chapter3.campfire"
        },
        {
          "nodeId": "chapter3.campfire",
          "type": "camp",
          "speaker": "旅伴",
          "title": "最后的营火",
          "recollectionId": "three-lanterns",
          "recollectionTitle": "三盏灯与回信",
          "recollectionText": "莉娅、瑟琳和菲妮的旅途笔记在营火边叠在一起，最后一封回信指向回家的路。",
          "text": "营火照亮三张并肩摊开的地图。回信没有写终点，只写着：“灯还亮着，就有人会回来。”",
          "nextNodeId": "chapter3.end"
        },
        {
          "nodeId": "chapter3.end",
          "type": "chapter-end",
          "title": "第三章完成",
          "text": "三章的旅途在暖灯下合上。你知道这些词、这些路和这些同伴都会被好好保存。"
        }
      ]
    }
  ]
}
