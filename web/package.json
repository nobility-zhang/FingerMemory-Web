{
  "name": "finger-memory-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first keyboard vocabulary practice app.",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run type-check && npm run lint",
    "test": "vitest run",
    "audio:flip": "node scripts/generate-flashcard-flip-sound.mjs",
    "audio:battle": "node scripts/generate-battle-sounds.mjs",
    "test:p2-cross": "node scripts/p2-cross-client.mjs",
    "test:p3-fixture": "node scripts/p3-browser-fixture.mjs",
    "test:watch": "vitest",
    "build": "npm run type-check && vite build",
    "worker:build": "vite build --config worker.vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "1.73.0",
    "dexie": "4.4.7",
    "papaparse": "5.7.1",
    "phaser": "4.2.1",
    "ts-fsrs": "6.0.0",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
